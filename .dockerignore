# Rust build artifacts
target/

# Git history
.git/
.gitattributes
.gitignore

# Local data and environment
.hq-data/
.fastembed_cache/
.env
.env.local
.envrc

# IDE, OS, and project config
.claude/
.DS_Store
*.swp
*.swo
*~

# Content not needed at build time
notes/
docs/
db/
marginalia.org

# Web UI build dependencies
web-ui/node_modules/

# Tests and examples
tests/
examples/

# Python sandbox artifacts. The Docker build compiles the component from
# guest.py inside the builder, so a locally built wasm must not leak in.
src/ai/tools/python/sandbox.wasm
src/ai/tools/python/__pycache__/

# Vendored macOS uv binary. The builder copies the Linux build from the official
# uv image instead.
bin/uv
